# === Server Runut - contoh konfigurasi (tanpa nilai rahasia) ===
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Daftar origin CORS tambahan di production (dipisah koma, tanpa trailing slash):
# Arsitektur same-origin Cloudflare Pages + Pages Functions Proxy (disarankan):
#   FRONTEND_URL=https://runut-web.pages.dev
#   CORS_ORIGINS=https://runut-web.pages.dev
#   COOKIE_SAME_SITE=lax
#   COOKIE_SECURE=true
CORS_ORIGINS=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

# === Penyimpanan Dokumen Persisten (Cloudflare R2 Free - privat, S3-compatible) ===
# Di production pada Render Free (disk ephemeral), gunakan FILE_STORAGE_PROVIDER=r2
FILE_STORAGE_PROVIDER=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Penyimpanan:
# - Di production: DATABASE_URL wajib diisi (PostgreSQL).
# - Di development: jika DATABASE_URL kosong, menggunakan berkas persisten lokal (.data/runut-storage.json).
DATABASE_URL=
# Opsional untuk tuning koneksi PostgreSQL di production (Render/Supabase/Neon/Railway):
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_STATEMENT_TIMEOUT_MS=15000
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Auth. Bila dikosongkan di dev, server memakai kunci acak sementara.
# Isi untuk pemakaian sehari-hari:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_DAYS=30

# === AI provider (100% Zero-Cost Free-Only Fallback Chain) ===
# Kebijakan STRICT_FREE_AI_ONLY=true memblokir provider/model berbayar secara otomatis.
STRICT_FREE_AI_ONLY=true
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=particle-ai/particle-1:free
AI_TIMEOUT_MS=90000

# Fallback Gratis #1: Google Gemini Free Tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Fallback Gratis #2: Groq Free Developer Tier
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Daftar email admin (dipisah koma) untuk dashboard pemantauan kuota AI
ADMIN_EMAILS=

# === OCR untuk PDF pindai & Verifikasi Eksternal (Crossref / OpenAlex) ===
OCR_ENABLED=true
OCR_LANGUAGES=ind+eng
OCR_CONFIDENCE_THRESHOLD=75
ENABLE_EXTERNAL_VERIFICATION=false

# === Konversi DOC/DOCX/PDF (LibreOffice headless - Docker TIDAK wajib untuk pengembangan Windows) ===
# Kosongkan untuk deteksi otomatis:
# - Windows (utamakan soffice.com untuk output konsol): C:\Program Files\LibreOffice\program\soffice.com
# - Fallback Windows: C:\Program Files\LibreOffice\program\soffice.exe atau Program Files (x86)
# - Linux/Docker: /usr/bin/soffice atau soffice di PATH
LIBREOFFICE_PATH=
DOCX_PDF_CONVERSION_ENABLED=true
DOCX_PDF_TIMEOUT_MS=120000

# === Payment gateway (Midtrans) untuk Pembelian Token ===
# Paket token ditentukan di server (Hemat 5 token Rp5.000, Populer 10 token Rp9.000, Lebih Hemat 20 token Rp16.000).
# Gunakan SB-Mid-server-... untuk Sandbox, Mid-server-... untuk Production.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_BASE=
MIDTRANS_QRIS_ACQUIRER=gopay
PAYMENT_EXPIRY_HOURS=24

# === Email reset password & verifikasi OTP (SMTP - 100% Gratis via Gmail App Password) ===
# Tanpa ini endpoint forgot-password & resend-otp menjawab 503 eksplisit.
# Contoh Gmail gratis: MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_SECURE=true,
# MAIL_USER=emailanda@gmail.com, MAIL_PASS=<16-karakter App Password Google>
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Runut <no-reply@runut.local>

# === Login & Daftar dengan Akun Google (OAuth2 / Google Identity Services - Gratis) ===
# Isi dengan OAuth 2.0 Client ID (Web application) dari Google Cloud Console.
GOOGLE_CLIENT_ID=
