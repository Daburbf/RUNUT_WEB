# === Server Runut - contoh konfigurasi (tanpa nilai rahasia) ===
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Penyimpanan:
# - Di production: DATABASE_URL wajib diisi (PostgreSQL).
# - Di development: jika DATABASE_URL kosong, menggunakan berkas persisten lokal (.data/runut-storage.json).
DATABASE_URL=

# Auth. Bila dikosongkan di dev, server memakai kunci acak sementara.
# Isi untuk pemakaian sehari-hari:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_DAYS=30

# === AI provider: Google Gemini / 9Router / OpenAI ===
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_TIMEOUT_MS=90000

# === Payment gateway (Midtrans) untuk Pembelian Token ===
# Paket token ditentukan di server (Hemat 5 token Rp5.000, Populer 10 token Rp9.000, Lebih Hemat 20 token Rp16.000).
# Gunakan SB-Mid-server-... untuk Sandbox, Mid-server-... untuk Production.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_BASE=
MIDTRANS_QRIS_ACQUIRER=gopay
PAYMENT_EXPIRY_HOURS=24

# === Email reset password (SMTP) ===
# Tanpa ini endpoint forgot-password menjawab 503 eksplisit.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Runut <no-reply@runut.local>
