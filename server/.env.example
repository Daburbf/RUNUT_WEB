# === Server Runut - contoh konfigurasi (tanpa nilai rahasia) ===
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Daftar origin CORS tambahan di production (dipisah koma, tanpa trailing slash):
# Arsitektur same-origin Cloudflare Pages + Pages Functions Proxy (disarankan):
#   FRONTEND_URL=https://runut-web.pages.dev
#   CORS_ORIGINS=https://runut-web.pages.dev
#   COOKIE_SAME_SITE=lax
#   COOKIE_SECURE=true
CORS_ORIGINS=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true

# === Penyimpanan Dokumen Persisten (Primary: Oracle Object Storage Always Free; Optional: Cloudflare R2) ===
# Gunakan OBJECT_STORAGE_PROVIDER=oci untuk Oracle Object Storage (tidak ada failover otomatis ke R2).
# Batas aman aplikasi OCI default: 8 GB Standard (aman saat Free Trial 10 GB Standard), 40.000 API req/bln, 8 TB outbound/bln.
# HANYA setelah operator memverifikasi akun sudah Always Free-only (20 GB gabungan), batas boleh dinaikkan
# secara eksplisit hingga maksimal 16 GB dengan OCI_OS_ALWAYS_FREE_VERIFIED=true dan OCI_MAX_MANAGED_BYTES=17179869184.
OBJECT_STORAGE_PROVIDER=auto
STRICT_STORAGE_QUOTA_MODE=true
OCI_OS_ALWAYS_FREE_VERIFIED=false
# OCI_MAX_MANAGED_BYTES=8589934592
OCI_OS_NAMESPACE=
OCI_OS_REGION=
OCI_OS_BUCKET=
OCI_OS_ACCESS_KEY_ID=
OCI_OS_SECRET_ACCESS_KEY=

# Alternatif opsional (hanya bila OBJECT_STORAGE_PROVIDER=r2):
FILE_STORAGE_PROVIDER=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Penyimpanan:
# - Di production: DATABASE_URL wajib diisi (PostgreSQL).
# - Di development: jika DATABASE_URL kosong, menggunakan berkas persisten lokal (.data/runut-storage.json).
DATABASE_URL=
# Opsional untuk tuning koneksi PostgreSQL di production (Render/Supabase/Neon/Railway):
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_STATEMENT_TIMEOUT_MS=15000
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Auth. Bila dikosongkan di dev, server memakai kunci acak sementara.
# Isi untuk pemakaian sehari-hari:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_DAYS=30

# === AI provider (100% Online Zero-Cost Free-Only Multi-Model Registry) ===
# Kebijakan STRICT_FREE_AI_ONLY=true memblokir provider/model berbayar & model retired secara otomatis.
STRICT_FREE_AI_ONLY=true
AI_FAILOVER_ENABLED=true
AI_MAX_PROVIDER_ATTEMPTS=4
AI_MAX_RETRIES_PER_PROVIDER=1
AI_PROVIDER=openrouter
AI_TIMEOUT_MS=90000

# OpenRouter Free Models (berbagi batas akun gratis: 50 req/hari & 20 req/menit)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=particle-ai/particle-1:free
OPENROUTER_FALLBACK_MODEL_1=baidu/ernie-5.5-flash-preview:free
OPENROUTER_FALLBACK_MODEL_2=inclusionai/ling-3.2-flash:free
OPENROUTER_DYNAMIC_MODEL=openrouter/free
# Opsional (NONAKTIF secara default; memiliki peringatan penggunaan data - dilarang untuk dokumen rahasia)
ENABLE_NEMOTRON_FREE=false

# Provider Independen: Google AI Studio Gemini Free Tier (reset harian tengah malam waktu Pasifik)
GEMINI_API_KEY=
GEMINI_CONTENT_MODEL=gemini-3.1-flash-lite

# Groq (NONAKTIF secara default; llama-3.3-70b-versatile telah dihentikan 16 Agustus 2026)
# Hanya aktifkan bila akun Free Tier & model pengganti telah diverifikasi tanpa billing berbayar.
ENABLE_GROQ_FREE=false
GROQ_FREE_VERIFIED=false
GROQ_API_KEY=
GROQ_MODEL=

# === Optional Verified Free DeepSeek V4.1 Flash Providers (NONAKTIF secara default) ===
# Persetujuan eksplisit wajib aktif untuk mengirim teks non-rahasia ke rute gratis pihak ketiga.
ALLOW_THIRD_PARTY_FREE_AI_PROCESSING=false

# Token Harbor (rolling 7x24 jam value-based allowance, 60 RPM / 1800 RPH, dilarang untuk dokumen rahasia)
ENABLE_TOKEN_HARBOR_FREE=false
TOKEN_HARBOR_API_KEY=
TOKEN_HARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKEN_HARBOR_FREE_MODEL=deepseek-v4.1-flash:free

# BeatAPI (1 req sukses/menit sebelum top-up, preflight katalog gratis wajib, dilarang untuk dokumen rahasia)
ENABLE_BEATAPI_FREE=false
BEATAPI_API_KEY=
BEATAPI_BASE_URL=https://direct.beatapi.io/v1
BEATAPI_FREE_MODEL=deepseek-v4.1-flash-free

# === Strict Original Document Template Preservation ===
STRICT_TEMPLATE_PRESERVATION=true
PRESERVE_ORIGINAL_DOCUMENT=true
ALLOW_TEMPLATE_REGENERATION=false
ALLOW_SILENT_FORMAT_CONVERSION=false
MAX_DOCUMENT_TEXT_GROWTH_RATIO=1.15
MAX_TEMPLATE_REPAIR_ATTEMPTS=1

# Daftar email admin (dipisah koma) untuk dashboard pemantauan kuota AI
ADMIN_EMAILS=

# === OCR untuk PDF pindai & Verifikasi Eksternal (Crossref / OpenAlex) ===
OCR_ENABLED=true
OCR_LANGUAGES=ind+eng
OCR_CONFIDENCE_THRESHOLD=75
ENABLE_EXTERNAL_VERIFICATION=false

# === Konversi DOC/DOCX/PDF (LibreOffice headless - Docker TIDAK wajib untuk pengembangan Windows) ===
# Kosongkan untuk deteksi otomatis:
# - Windows (utamakan soffice.com untuk output konsol): C:\Program Files\LibreOffice\program\soffice.com
# - Fallback Windows: C:\Program Files\LibreOffice\program\soffice.exe atau Program Files (x86)
# - Linux/Docker: /usr/bin/soffice atau soffice di PATH
LIBREOFFICE_PATH=
DOCX_PDF_CONVERSION_ENABLED=true
DOCX_PDF_TIMEOUT_MS=120000

# === Payment gateway (Midtrans) untuk Pembelian Token ===
# Paket token ditentukan di server (Hemat 5 token Rp5.000, Populer 10 token Rp9.000, Lebih Hemat 20 token Rp16.000).
# Gunakan SB-Mid-server-... untuk Sandbox, Mid-server-... untuk Production.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_BASE=
MIDTRANS_QRIS_ACQUIRER=gopay
PAYMENT_EXPIRY_HOURS=24

# === Email reset password & verifikasi OTP (SMTP - 100% Gratis via Gmail App Password) ===
# Tanpa ini endpoint forgot-password & resend-otp menjawab 503 eksplisit.
# Contoh Gmail gratis: MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_SECURE=true,
# MAIL_USER=emailanda@gmail.com, MAIL_PASS=<16-karakter App Password Google>
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Runut <no-reply@runut.local>

# === Login & Daftar dengan Akun Google (OAuth2 / Google Identity Services - Gratis) ===
# Isi dengan OAuth 2.0 Client ID (Web application) dari Google Cloud Console.
GOOGLE_CLIENT_ID=
